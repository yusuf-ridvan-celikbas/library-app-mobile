<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <!--
    Target <-> Lilies Lib extension, contract v1 (Target repo: docs/lilies-lib-contract.md).
    Target is signed with a different key, so signature permissions can't be used.

    Everything here runs in the separate ":target" process: the app opens the same SQLite file with
    expo-sqlite's own SQLite copy, and two SQLite copies in one process can corrupt it (see LiliesDb.kt).
  -->

  <!-- Dangerous level: Android asks the user ("Allow Target to read your Lilies Lib library?"). -->
  <permission
    android:name="com.anonymous.eighteeneleven.permission.READ_LIBRARY"
    android:protectionLevel="dangerous"
    android:label="@string/lilies_read_library_label"
    android:description="@string/lilies_read_library_description" />

  <application>
    <!-- Target: "Add from Lilies Lib" — returns the one book the user taps. -->
    <activity
      android:name="com.lilieslib.targetpicker.PickBookActivity"
      android:process=":target"
      android:exported="true"
      android:label="Lilies Lib"
      android:theme="@android:style/Theme.Material.Light.NoActionBar"
      android:windowSoftInputMode="adjustResize"
      android:excludeFromRecents="true">
      <intent-filter>
        <action android:name="com.ridvan.target.action.PICK_BOOK" />
        <category android:name="android.intent.category.DEFAULT" />
      </intent-filter>
    </activity>

    <!-- Target: "Send to Lilies Lib" — the user confirms before anything is added. -->
    <activity
      android:name="com.lilieslib.targetpicker.AddBookActivity"
      android:process=":target"
      android:exported="true"
      android:label="Lilies Lib"
      android:theme="@android:style/Theme.Material.Light.NoActionBar"
      android:excludeFromRecents="true">
      <intent-filter>
        <action android:name="com.ridvan.target.action.ADD_BOOK" />
        <category android:name="android.intent.category.DEFAULT" />
      </intent-filter>
    </activity>

    <!-- Target sync: read-only list of books, only with READ_LIBRARY. -->
    <provider
      android:name="com.lilieslib.targetpicker.LibraryProvider"
      android:authorities="com.anonymous.eighteeneleven.target"
      android:process=":target"
      android:exported="true"
      android:readPermission="com.anonymous.eighteeneleven.permission.READ_LIBRARY" />
  </application>
</manifest>
